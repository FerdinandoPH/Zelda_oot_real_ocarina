+/**
+ * Per-frame Audio Ocarina update on the game side, called from Message_Update() before vanilla updates the message.
+ *
+ * Classifies the message state (Message_GetAudioOcarinaContext()), tells audio_ocarina_input.c whether audio mode may
+ * stay active and whether notes are accepted, and, when the player can play, runs the audio mode state machine with
+ * the controller's newly pressed buttons.
+ *
+ * When audio mode is entered or left, the vanilla ocarina is restarted by going back to its "starting" message mode
+ * (MSGMODE_OCARINA_STARTING or MSGMODE_SONG_PLAYBACK_STARTING). This clears the notes vanilla had already recorded,
+ * so a song cannot be completed with a mix of button and microphone notes. When audio mode starts in free play, the
+ * staff texture is loaded as well so Message_DrawAudioOcarinaStaff() can use it.
+ *
+ * @param play current play state
+ */
+void Message_UpdateAudioOcarina(PlayState* play) {
+    MessageContext* msgCtx = &play->msgCtx;
+    AudioOcarinaContext context;
+
+#if AUDIO_OCARINA_TEST
+    Message_UpdateAudioOcarinaTestHooks(play);
+#endif
+
+    context = Message_GetAudioOcarinaContext(msgCtx);
+
+    AudioOcarinaInput_CheckMessageState(context != AOC_CONTEXT_NONE);
+    AudioOcarinaInput_SetInputOpen(context == AOC_CONTEXT_INPUT);
+
+    if (context != AOC_CONTEXT_INPUT) {
+        return;
+    }
+
+    if (AudioOcarinaInput_UpdatePlaying(play->state.input[0].press.button) == AOC_ACTION_RESTART_OCARINA) {
+        // Entering or leaving audio mode: start the song check over so no stale notes remain in it
+        if (msgCtx->msgMode == MSGMODE_OCARINA_PLAYING) {
+            if (AudioOcarinaInput_IsListening() && (msgCtx->ocarinaAction == OCARINA_ACTION_FREE_PLAY ||
+                                                    msgCtx->ocarinaAction == OCARINA_ACTION_CHECK_NOWARP)) {
+                Message_LoadAudioOcarinaStaff(play);
+            }
+            msgCtx->msgMode = MSGMODE_OCARINA_STARTING;
+        } else if (msgCtx->msgMode == MSGMODE_SONG_PLAYBACK) {
+            msgCtx->msgMode = MSGMODE_SONG_PLAYBACK_STARTING;
+        }
+        // The frogs and the memory game restart their check for every note / round by themselves
+    }
+}
