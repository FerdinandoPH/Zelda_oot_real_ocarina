+/**
+ * Test-build only (AUDIO_OCARINA_TEST=1). Applies the requests a debugger wrote into the gAocTest* variables and
+ * mirrors some message state for it to read, so automated tests can reach any ocarina situation without playing.
+ *
+ *  - gAocTestAutoAdvance: plays the part of the Skull Kid / frog actors, which are not present in the test setup, so
+ *    the memory game and the frog game advance to the player's turn.
+ *  - gAocTestPlayerPos: teleports Link once to the given position.
+ *  - gAocTestEntrance: triggers a warp to that entrance (value - 1) with a fade to black.
+ *  - gAocTestOcarinaAction: opens the ocarina with that action (value - 1), once no message is shown.
+ *
+ * Each request is cleared once applied. Called at the start of Message_UpdateAudioOcarina().
+ *
+ * @param play current play state
+ */
+void Message_UpdateAudioOcarinaTestHooks(PlayState* play) {
+    MessageContext* msgCtx = &play->msgCtx;
+
+    if (gAocTestAutoAdvance) {
+        if ((msgCtx->msgMode == MSGMODE_MEMORY_GAME_LEFT_SKULLKID_WAIT) ||
+            (msgCtx->msgMode == MSGMODE_MEMORY_GAME_RIGHT_SKULLKID_WAIT)) {
+            Message_UpdateOcarinaMemoryGame(play);
+        } else if ((msgCtx->msgMode == MSGMODE_MEMORY_GAME_START_NEXT_ROUND) &&
+                   !Audio_IsSfxPlaying(NA_SE_SY_METRONOME)) {
+            AudioOcarina_SetInstrument(OCARINA_INSTRUMENT_FLUTE);
+            AudioOcarina_SetPlaybackSong(OCARINA_SONG_MEMORY_GAME + 1, 1);
+            msgCtx->msgMode = MSGMODE_MEMORY_GAME_LEFT_SKULLKID_PLAYING;
+            msgCtx->stateTimer = 2;
+        } else if (msgCtx->msgMode == MSGMODE_FROGS_WAITING) {
+            msgCtx->msgMode = MSGMODE_FROGS_START;
+        }
+    }
+    gAocTestMsgMode = msgCtx->msgMode;
+    gAocTestLastButton = msgCtx->lastOcarinaButtonIndex;
+    gAocTestOcarinaMode = msgCtx->ocarinaMode;
+    gAocTestLastPlayedSong = msgCtx->lastPlayedSong;
+
+    if (gAocTestPlayerPos.enable != 0) {
+        Player* player = GET_PLAYER(play);
+
+        player->actor.world.pos.x = player->actor.home.pos.x = gAocTestPlayerPos.x;
+        player->actor.world.pos.y = player->actor.home.pos.y = gAocTestPlayerPos.y;
+        player->actor.world.pos.z = player->actor.home.pos.z = gAocTestPlayerPos.z;
+        gAocTestPlayerPos.enable = 0;
+    }
+    if (gAocTestEntrance != 0) {
+        play->nextEntranceIndex = gAocTestEntrance - 1;
+        play->transitionTrigger = TRANS_TRIGGER_START;
+        play->transitionType = TRANS_TYPE_FADE_BLACK;
+        gAocTestEntrance = 0;
+    }
+    if ((gAocTestOcarinaAction != 0) && (play->msgCtx.msgLength == 0)) {
+        Message_StartOcarina(play, gAocTestOcarinaAction - 1);
+        gAocTestOcarinaAction = 0;
+    }
+}
