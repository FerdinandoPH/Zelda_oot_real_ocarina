 #endif
 
+#if AUDIO_OCARINA
+// Audio Ocarina UI: prompt/status text and, in free play, a staff showing the accepted notes
+
+#define AOC_TEXT_SCALE 0.75f
+#define AOC_TEXT_RIGHT_XPOS 286
+#define AOC_TEXT_YPOS 126
+#define AOC_OCTAVE_TEXT_YPOS 112
+#define AOC_STAFF_XPOS 34
+#define AOC_STAFF_YPOS 142
+#define AOC_STAFF_WIDTH 256
+#define AOC_STAFF_HEIGHT 64
+#define AOC_STAFF_ALPHA 180
+#define AOC_MESSAGE_STATIC_OCARINA_INDEX 2 // index of the ocarina textbox texture in message_static
+#define AOC_GLYPH_SLOTS 40
+
+static const char sAudioOcarinaPromptText[] = "D-Pad Up: Audio";
+static const char sAudioOcarinaListeningText[] = "Listening...  B: Cancel";
+static const char sAudioOcarinaOctaveText[] = "D-Pad: Octave ";
+static const char sAudioOcarinaErrorText[] = "Audio device not found.";
+
+static u64 sAudioOcarinaGlyphTex[AOC_GLYPH_SLOTS][FONT_CHAR_TEX_SIZE / sizeof(u64)];
+static u8 sAudioOcarinaGlyphSlot[0x80 - ' ']; // 0 = not loaded, else slot + 1
+static u8 sAudioOcarinaGlyphCount = 0;
+
+/**
+ * Returns the texture of an ASCII character of the game font, loading it from the ROM on first use.
+ *
+ * On the N64 most assets stay in the cartridge ROM and must be copied to RAM (with a DMA) before the graphics chip can
+ * use them. The message system normally only loads the glyphs of the message being shown, into a buffer it reuses for
+ * every message, so our texts cannot rely on it. Each glyph needed here is copied once from nes_font_static (the
+ * English font, one 4-bit intensity texture per character in ASCII order starting at ' ') into
+ * sAudioOcarinaGlyphTex, and remembered in sAudioOcarinaGlyphSlot. At most AOC_GLYPH_SLOTS different characters fit.
+ *
+ * DMA_REQUEST_SYNC blocks until the copy is done; that only happens the first time a character is drawn.
+ *
+ * @param c printable ASCII character (' '..0x7F)
+ * @return pointer to the glyph texture in RAM, or NULL if `c` is not printable or the glyph cache is full
+ */
+void* Message_GetAudioOcarinaGlyph(char c) {
+    u8 index = c - ' ';
+
+    if (index >= ARRAY_COUNT(sAudioOcarinaGlyphSlot)) {
+        return NULL;
+    }
+    if (sAudioOcarinaGlyphSlot[index] == 0) {
+        if (sAudioOcarinaGlyphCount >= AOC_GLYPH_SLOTS) {
+            return NULL;
+        }
+        DMA_REQUEST_SYNC(sAudioOcarinaGlyphTex[sAudioOcarinaGlyphCount],
+                         (uintptr_t)_nes_font_staticSegmentRomStart + index * FONT_CHAR_TEX_SIZE, FONT_CHAR_TEX_SIZE,
+                         "../z_message_PAL.c", __LINE__);
+        sAudioOcarinaGlyphCount++;
+        sAudioOcarinaGlyphSlot[index] = sAudioOcarinaGlyphCount;
+    }
+    return sAudioOcarinaGlyphTex[sAudioOcarinaGlyphSlot[index] - 1];
+}
+
+/**
+ * Measures the width a string will have when drawn with Message_DrawAudioOcarinaString(), using the game's
+ * proportional font widths (sFontWidths) scaled by AOC_TEXT_SCALE. Used to right-align texts.
+ *
+ * @param str NUL-terminated printable ASCII string
+ * @return width in screen pixels
+ */
+f32 Message_GetAudioOcarinaStringWidth(const char* str) {
+    f32 width = 0.0f;
+
+    for (; *str != '\0'; str++) {
+        width += sFontWidths[*str - ' '] * AOC_TEXT_SCALE;
+    }
+    return width;
+}
+
+/**
+ * Appends to a display list the commands that draw a string with the game font and a black drop shadow.
+ *
+ * N64 graphics are not drawn immediately: the CPU writes a list of commands (a display list, `Gfx`) that the RSP/RDP
+ * graphics chips execute later. `*p` points to the next free slot of the list; every gDP.../gSP... macro writes one
+ * command there and advances the pointer, and the updated pointer is returned through `p`.
+ *
+ * For each character: the glyph texture is loaded into the RDP's texture memory (gDPLoadTextureBlock_4b), then
+ * gSPTextureRectangle draws it as a screen rectangle, first in black one pixel down-right (the shadow) and then in
+ * the requested color. The color comes from the "primitive color" and the combiner (gDPSetCombineLERP) multiplies it
+ * by the glyph's intensity. Rectangle coordinates are in 10.2 fixed point, hence the `<< 2`; the texture step
+ * `charScale` (1024 = 1 texel per pixel) shrinks the 16x16 glyph to AOC_TEXT_SCALE. Spaces only advance the cursor.
+ *
+ * The caller must have set up a 2D render mode first (Gfx_SetupDL_39Ptr).
+ *
+ * @param p   in/out: display list write pointer
+ * @param str NUL-terminated printable ASCII string
+ * @param x   left edge in screen pixels
+ * @param y   top edge in screen pixels
+ * @param r,g,b,a text color and opacity
+ */
+void Message_DrawAudioOcarinaString(Gfx** p, const char* str, s16 x, s16 y, u8 r, u8 g, u8 b, u8 a) {
+    Gfx* gfx = *p;
+    s16 charSize = AOC_TEXT_SCALE * FONT_CHAR_TEX_WIDTH;
+    s16 charScale = 1024.0f / AOC_TEXT_SCALE;
+    f32 posX = x;
+    void* tex;
+    s16 drawX;
+
+    gDPPipeSync(gfx++);
+    gDPSetCombineLERP(gfx++, 0, 0, 0, PRIMITIVE, TEXEL0, 0, PRIMITIVE, 0, 0, 0, 0, PRIMITIVE, TEXEL0, 0, PRIMITIVE, 0);
+
+    for (; *str != '\0'; str++) {
+        if (*str != ' ') {
+            tex = Message_GetAudioOcarinaGlyph(*str);
+            if (tex != NULL) {
+                drawX = posX;
+                gDPPipeSync(gfx++);
+                gDPLoadTextureBlock_4b(gfx++, tex, G_IM_FMT_I, FONT_CHAR_TEX_WIDTH, FONT_CHAR_TEX_HEIGHT, 0,
+                                       G_TX_NOMIRROR | G_TX_CLAMP, G_TX_NOMIRROR | G_TX_CLAMP, G_TX_NOMASK,
+                                       G_TX_NOMASK, G_TX_NOLOD, G_TX_NOLOD);
+                // Drop shadow
+                gDPSetPrimColor(gfx++, 0, 0, 0, 0, 0, a);
+                gSPTextureRectangle(gfx++, (drawX + 1) << 2, (y + 1) << 2, (drawX + 1 + charSize) << 2,
+                                    (y + 1 + charSize) << 2, G_TX_RENDERTILE, 0, 0, charScale, charScale);
+                gDPPipeSync(gfx++);
+                gDPSetPrimColor(gfx++, 0, 0, r, g, b, a);
+                gSPTextureRectangle(gfx++, drawX << 2, y << 2, (drawX + charSize) << 2, (y + charSize) << 2,
+                                    G_TX_RENDERTILE, 0, 0, charScale, charScale);
+            }
+        }
+        posX += sFontWidths[*str - ' '] * AOC_TEXT_SCALE;
+    }
+
+    *p = gfx;
+}
+
+/**
+ * Copies the ocarina staff background texture (the red textbox with the five staff lines) from the ROM into the
+ * message system's textbox texture buffer.
+ *
+ * Song checks and song playback open a textbox that loads this texture, but free play shows no textbox, so the
+ * buffer may hold another texture (or nothing useful). Called when audio mode starts in free play, before
+ * Message_DrawAudioOcarinaStaff() uses it. The ocarina texture is entry AOC_MESSAGE_STATIC_OCARINA_INDEX of
+ * message_static.
+ *
+ * @param play current play state
+ */
+void Message_LoadAudioOcarinaStaff(PlayState* play) {
+    MessageContext* msgCtx = &play->msgCtx;
+
+    DMA_REQUEST_SYNC(msgCtx->textboxSegment,
+                     (uintptr_t)_message_staticSegmentRomStart +
+                         (AOC_MESSAGE_STATIC_OCARINA_INDEX * MESSAGE_STATIC_TEX_SIZE),
+                     MESSAGE_STATIC_TEX_SIZE, "../z_message_PAL.c", __LINE__);
+}
+
+/**
+ * Draws a staff with the notes accepted in audio mode, like the one vanilla shows when it checks a song.
+ *
+ * Only used in free play: there vanilla draws no staff, and without one the player would not see which notes the
+ * device heard. Other ocarina actions already have a staff textbox on which vanilla draws the injected notes.
+ *
+ * Draws, in order: the semi-transparent staff background (the texture loaded by Message_LoadAudioOcarinaStaff()),
+ * the treble clef, and one note icon per entry of the note history (AudioOcarinaInput_GetDisplay()), placed at the
+ * height of its note and colored like vanilla (A notes blue, C notes yellow). Each icon fades in: its alpha is raised
+ * every frame until fully opaque. Positions, colors and fade step reuse the vanilla values (R_OCARINA_BUTTONS_*...).
+ *
+ * @param play         current play state
+ * @param p            in/out: display list write pointer (see Message_DrawAudioOcarinaString())
+ * @param noteTextures note icon textures indexed by OcarinaButtonIndex (vanilla sOcarinaNoteTextures)
+ */
+void Message_DrawAudioOcarinaStaff(PlayState* play, Gfx** p, void** noteTextures) {
+    MessageContext* msgCtx = &play->msgCtx;
+    AudioOcarinaDisplay* display = AudioOcarinaInput_GetDisplay();
+    Gfx* gfx = *p;
+    u16 notePosX;
+    s32 i;
+    u8 buttonIndex;
+
+    // Staff background and treble clef, as in Message_DrawTextBox for TEXTBOX_TYPE_OCARINA
+    Gfx_SetupDL_39Ptr(&gfx);
+    gDPPipeSync(gfx++);
+    gDPSetPrimColor(gfx++, 0, 0, 255, 0, 0, AOC_STAFF_ALPHA);
+    gDPSetEnvColor(gfx++, 0, 0, 0, 255);
+    gDPLoadTextureBlock_4b(gfx++, msgCtx->textboxSegment, G_IM_FMT_IA, 128, 64, 0, G_TX_MIRROR, G_TX_MIRROR, 7, 0,
+                           G_TX_NOLOD, G_TX_NOLOD);
+    gSPTextureRectangle(gfx++, AOC_STAFF_XPOS << 2, AOC_STAFF_YPOS << 2, (AOC_STAFF_XPOS + AOC_STAFF_WIDTH) << 2,
+                        (AOC_STAFF_YPOS + AOC_STAFF_HEIGHT) << 2, G_TX_RENDERTILE, 0, 0, 1 << 10, 1 << 10);
+
+    gDPPipeSync(gfx++);
+    gDPSetCombineLERP(gfx++, 1, 0, PRIMITIVE, 0, TEXEL0, 0, PRIMITIVE, 0, 1, 0, PRIMITIVE, 0, TEXEL0, 0, PRIMITIVE, 0);
+    gDPSetPrimColor(gfx++, 0, 0, 255, 100, 0, 255);
+    gDPLoadTextureBlock_4b(gfx++, gOcarinaTrebleClefTex, G_IM_FMT_I, 16, 32, 0, G_TX_MIRROR, G_TX_MIRROR, G_TX_NOMASK,
+                           G_TX_NOMASK, G_TX_NOLOD, G_TX_NOLOD);
+    gSPTextureRectangle(gfx++, R_TEXTBOX_CLEF_XPOS << 2, R_TEXTBOX_CLEF_YPOS << 2, (R_TEXTBOX_CLEF_XPOS + 16) << 2,
+                        (R_TEXTBOX_CLEF_YPOS + 32) << 2, G_TX_RENDERTILE, 0, 0, 1 << 10, 1 << 10);
+
+    // Accepted notes, same look as the vanilla staff notes
+    Gfx_SetupDL_39Ptr(&gfx);
+    gDPSetCombineLERP(gfx++, PRIMITIVE, ENVIRONMENT, TEXEL0, ENVIRONMENT, TEXEL0, 0, PRIMITIVE, 0, PRIMITIVE,
+                      ENVIRONMENT, TEXEL0, ENVIRONMENT, TEXEL0, 0, PRIMITIVE, 0);
+
+    for (notePosX = R_OCARINA_BUTTONS_XPOS, i = 0; i < display->count; i++) {
+        buttonIndex = display->buttonIndex[i];
+        if (buttonIndex > OCARINA_BTN_C_UP) {
+            continue;
+        }
+
+        if (display->alpha[i] != 255) {
+            display->alpha[i] += R_OCARINA_BUTTONS_APPEAR_ALPHA_STEP;
+            if (display->alpha[i] >= 255) {
+                display->alpha[i] = 255;
+            }
+        }
+
+        gDPPipeSync(gfx++);
+        if (buttonIndex == OCARINA_BTN_A) {
+            gDPSetPrimColor(gfx++, 0, 0, sOcarinaButtonAPrimR, sOcarinaButtonAPrimG, sOcarinaButtonAPrimB,
+                            display->alpha[i]);
+            gDPSetEnvColor(gfx++, sOcarinaButtonAEnvR, sOcarinaButtonAEnvG, sOcarinaButtonAEnvB, 0);
+        } else {
+            gDPSetPrimColor(gfx++, 0, 0, sOcarinaButtonCPrimR, sOcarinaButtonCPrimG, sOcarinaButtonCPrimB,
+                            display->alpha[i]);
+            gDPSetEnvColor(gfx++, sOcarinaButtonCEnvR, sOcarinaButtonCEnvG, sOcarinaButtonCEnvB, 0);
+        }
+
+        gDPLoadTextureBlock(gfx++, noteTextures[buttonIndex], G_IM_FMT_IA, G_IM_SIZ_8b, 16, 16, 0,
+                            G_TX_NOMIRROR | G_TX_WRAP, G_TX_NOMIRROR | G_TX_WRAP, G_TX_NOMASK, G_TX_NOMASK, G_TX_NOLOD,
+                            G_TX_NOLOD);
+        gSPTextureRectangle(gfx++, notePosX << 2, R_OCARINA_BUTTONS_YPOS(buttonIndex) << 2, (notePosX + 16) << 2,
+                            (R_OCARINA_BUTTONS_YPOS(buttonIndex) + 16) << 2, G_TX_RENDERTILE, 0, 0, 1 << 10, 1 << 10);
+        notePosX += R_OCARINA_BUTTONS_XPOS_OFFSET;
+    }
+
+    *p = gfx;
+}
+
+typedef enum AudioOcarinaContext {
+    /* 0 */ AOC_CONTEXT_NONE,  // audio mode is not available and ends
+    /* 1 */ AOC_CONTEXT_KEEP,  // transitional ocarina mode: audio mode survives, notes are ignored
+    /* 2 */ AOC_CONTEXT_INPUT  // the player can play notes: audio mode can be used
+} AudioOcarinaContext;
+
+/**
+ * Classifies the current state of the message system for Audio Ocarina.
+ *
+ * In OoT the ocarina is driven by the message system: playing the ocarina, checking a song, the Skull Kid memory
+ * game or the frogs are all "messages" whose progress is stored in msgCtx->msgMode. This function sorts those modes:
+ *  - AOC_CONTEXT_INPUT: the player can play notes right now; audio mode can be entered and notes are accepted.
+ *  - AOC_CONTEXT_KEEP: the ocarina is still open but in a transition (start/fail animations, Skull Kid's or the frogs'
+ *    turn, retrying a taught song...); audio mode stays active but notes are ignored.
+ *  - AOC_CONTEXT_NONE: anything else; audio mode ends.
+ *
+ * Scarecrow recording is deliberately excluded: it records note lengths and R/Z semitones, which the device cannot
+ * provide.
+ *
+ * @param msgCtx message context of the current play state
+ * @return the context for this frame
+ */
+AudioOcarinaContext Message_GetAudioOcarinaContext(MessageContext* msgCtx) {
+    if (msgCtx->msgLength == 0) {
+        return AOC_CONTEXT_NONE;
+    }
+
+    switch (msgCtx->msgMode) {
+        case MSGMODE_OCARINA_PLAYING:
+        case MSGMODE_SONG_PLAYBACK:
+        case MSGMODE_MEMORY_GAME_PLAYER_PLAYING:
+        case MSGMODE_FROGS_PLAYING:
+            return AOC_CONTEXT_INPUT;
+
+        case MSGMODE_OCARINA_STARTING:
+        case MSGMODE_OCARINA_FAIL:
+        case MSGMODE_OCARINA_NOTES_DROP:
+        case MSGMODE_SONG_PLAYBACK_STARTING:
+        case MSGMODE_SONG_PLAYBACK_FAIL:
+        case MSGMODE_SONG_PLAYBACK_NOTES_DROP:
+        case MSGMODE_OCARINA_AWAIT_INPUT:
+        case MSGMODE_MEMORY_GAME_START:
+        case MSGMODE_MEMORY_GAME_LEFT_SKULLKID_PLAYING:
+        case MSGMODE_MEMORY_GAME_LEFT_SKULLKID_WAIT:
+        case MSGMODE_MEMORY_GAME_RIGHT_SKULLKID_PLAYING:
+        case MSGMODE_MEMORY_GAME_RIGHT_SKULLKID_WAIT:
+        case MSGMODE_MEMORY_GAME_ROUND_SUCCESS:
+        case MSGMODE_MEMORY_GAME_START_NEXT_ROUND:
+        case MSGMODE_FROGS_START:
+        case MSGMODE_FROGS_WAITING:
+            return AOC_CONTEXT_KEEP;
+
+        case MSGMODE_TEXT_NEXT_MSG:
+        case MSGMODE_TEXT_CONTINUING:
+        case MSGMODE_TEXT_DISPLAYING:
+            // Restarting an ocarina prompt (e.g. retrying a taught song) reopens its textbox for a few frames.
+            // Textboxes not opened by the ocarina have ocarinaAction 0xFFFF.
+            return (msgCtx->ocarinaAction != 0xFFFF) ? AOC_CONTEXT_KEEP : AOC_CONTEXT_NONE;
+
+        default:
+            return AOC_CONTEXT_NONE;
+    }
+}
+
+#if AUDIO_OCARINA_TEST
+// Test-build hooks, written from the debugger (emucap write_memory) to reach ocarina situations quickly.
+// gAocTestEntrance: entrance index + 1 to warp to. gAocTestOcarinaAction: OcarinaSongActionId + 1 to start.
+volatile u16 gAocTestEntrance = 0;
+volatile u16 gAocTestOcarinaAction = 0;
+// gAocTestPlayerPos: set .enable to 1 to move Link to (x, y, z)
+typedef struct AudioOcarinaTestPos {
+    /* 0x00 */ u32 enable;
+    /* 0x04 */ f32 x;
+    /* 0x08 */ f32 y;
+    /* 0x0C */ f32 z;
+} AudioOcarinaTestPos;
+volatile AudioOcarinaTestPos gAocTestPlayerPos = { 0, 0.0f, 0.0f, 0.0f };
