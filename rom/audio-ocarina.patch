+/**
+ * Draws the Audio Ocarina UI on top of the ocarina UI. Called at the end of Message_DrawMain().
+ *
+ * Only draws while the player can play notes. Shows, right-aligned above the note area:
+ *  - "D-Pad Up: Audio" while audio mode is off (how to enable it);
+ *  - "Audio device not found." in red for a moment after a failed probe or a disconnect;
+ *  - "Listening...  B: Cancel" while listening, plus "D-Pad: Octave <n>" if the device supports octave changes, and
+ *    in free play the staff with the accepted notes.
+ * Nothing is drawn during the few frames of probing.
+ *
+ * @param play         current play state
+ * @param p            in/out: display list write pointer (see Message_DrawAudioOcarinaString())
+ * @param noteTextures note icon textures indexed by OcarinaButtonIndex, passed to Message_DrawAudioOcarinaStaff()
+ */
+void Message_DrawAudioOcarina(PlayState* play, Gfx** p, void** noteTextures) {
+    MessageContext* msgCtx = &play->msgCtx;
+    Gfx* gfx = *p;
+    AudioOcarinaMode mode = AudioOcarinaInput_GetMode();
+    const char* text;
+    u8 r = 255;
+    u8 g = 255;
+    u8 b = 255;
+
+    if (Message_GetAudioOcarinaContext(msgCtx) != AOC_CONTEXT_INPUT) {
+        return;
+    }
+
+    if ((mode == AOC_MODE_LISTENING) && (msgCtx->msgMode == MSGMODE_OCARINA_PLAYING) &&
+        (msgCtx->ocarinaAction == OCARINA_ACTION_FREE_PLAY ||
+                                         msgCtx->ocarinaAction == OCARINA_ACTION_CHECK_NOWARP)) {
+        Message_DrawAudioOcarinaStaff(play, &gfx, noteTextures);
+    }
+
+    if (mode == AOC_MODE_LISTENING) {
+        text = sAudioOcarinaListeningText;
+    } else if (AudioOcarinaInput_GetErrorTimer() > 0) {
+        text = sAudioOcarinaErrorText;
+        g = 100;
+        b = 100;
+    } else if (mode == AOC_MODE_DISABLED) {
+        text = sAudioOcarinaPromptText;
+    } else {
+        // Probing, only lasts a few frames
+        *p = gfx;
+        return;
+    }
+
+    Gfx_SetupDL_39Ptr(&gfx);
+    Message_DrawAudioOcarinaString(&gfx, text, AOC_TEXT_RIGHT_XPOS - (s16)Message_GetAudioOcarinaStringWidth(text),
+                                   AOC_TEXT_YPOS, r, g, b, 255);
+
+    if ((mode == AOC_MODE_LISTENING) && AudioOcarinaInput_HasOctaveControl()) {
+        // "D-Pad: Octave +1" / "D-Pad: Octave 0" / "D-Pad: Octave -2"
+        char octaveText[sizeof(sAudioOcarinaOctaveText) + 3];
+        s8 octave = AudioOcarinaInput_GetOctave();
+        s32 len = sizeof(sAudioOcarinaOctaveText) - 1;
+        s32 i;
+
+        for (i = 0; i < len; i++) {
+            octaveText[i] = sAudioOcarinaOctaveText[i];
+        }
+        if (octave > 0) {
+            octaveText[len++] = '+';
+        } else if (octave < 0) {
+            octaveText[len++] = '-';
+            octave = -octave;
+        }
+        octaveText[len++] = '0' + octave;
+        octaveText[len] = '\0';
+
+        Message_DrawAudioOcarinaString(&gfx, octaveText,
+                                       AOC_TEXT_RIGHT_XPOS - (s16)Message_GetAudioOcarinaStringWidth(octaveText),
+                                       AOC_OCTAVE_TEXT_YPOS, 255, 255, 255, 255);
+    }
+
+    *p = gfx;
+}
